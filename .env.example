# -------------------------------------------------------------
# REAL CLOUD DATABASE CONFIGURATION (RECOMMENDED FOR VERCEL & PRODUCTION)
# -------------------------------------------------------------
# Simply paste your Cloud PostgreSQL connection string here:
# Supports Neon (neon.tech), Supabase (supabase.com), Vercel Postgres, or Railway.
# The system automatically detects postgresql:// or postgresql+pg8000:// and creates all tables.
#
# Examples:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# -------------------------------------------------------------
# ALTERNATIVE: LOCAL CAMPUS MYSQL / MARIADB
# -------------------------------------------------------------
# If deploying in a school computer lab or local campus server:
# DATABASE_TYPE=MYSQL
# MYSQL_URL=mysql+pymysql://root:@localhost:3306/deped_smile

# -------------------------------------------------------------
# SECURITY & FLASK
# -------------------------------------------------------------
SECRET_KEY=deped-smile-enterprise-secret-key-2026
PORT=5000
